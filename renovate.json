{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": [
		"config:recommended",
		"helpers:pinGitHubActionDigests",
		":semanticCommits"
	],
	"timezone": "Asia/Tokyo",
	"schedule": [
		"* 0-8 * * *"
	],
	"labels": [
		"dependencies"
	],
	"prConcurrentLimit": 5,
	"gitIgnoredAuthors": [
		"41898282+github-actions[bot]@users.noreply.github.com"
	],
	"packageRules": [
		{
			"matchDatasources": [
				"npm"
			],
			"minimumReleaseAge": "1 day"
		}
	]
}
