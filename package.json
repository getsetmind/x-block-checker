{
	"name": "x-block-checker",
	"version": "0.1.2",
	"description": "Check and record X block relationships from a schedulable CLI",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"check": "bun run format && bun run lint && bun run typecheck && bun test && bun run build && bun run compile",
		"check:quality": "quality-check",
		"cli": "bun src/cli.ts",
		"compile": "bun scripts/compile.ts",
		"format": "biome check --write --unsafe .",
		"install-local": "bun run compile && bun scripts/install-local.ts",
		"lint": "biome check --error-on-warnings .",
		"test": "bun test",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"puppeteer-core": "25.9.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.11",
		"@types/bun": "^1.4.0",
		"@types/node": "^26.4.0",
		"@yuu1111/biome-config": "2.0.0",
		"@yuu1111/knip-config": "1.0.7",
		"@yuu1111/quality-check": "4.0.0",
		"@yuu1111/tsconfig": "1.0.4",
		"knip": "^6.35.1",
		"typescript": "^7.0.2"
	}
}
