{
	"name": "x-block-checker",
	"version": "0.1.3",
	"description": "Check and record X block relationships from a schedulable CLI",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"check": "bun run format && bun run lint && bun run typecheck && bun test && bun run build && bun run compile",
		"check:quality": "quality-check",
		"cli": "bun src/cli.ts",
		"compile": "bun scripts/compile.ts",
		"diagnose:followers": "bun scripts/diagnose-followers.ts",
		"format": "biome check --write --unsafe .",
		"install-local": "bun run compile && bun scripts/install-local.ts",
		"lint": "biome check --error-on-warnings .",
		"test": "bun test",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"puppeteer-core": "25.16.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.6",
		"@types/bun": "^1.4.4",
		"@types/node": "^26.6.6",
		"@yuu1111/biome-config": "2.2.7",
		"@yuu1111/knip-config": "2.1.0",
		"@yuu1111/quality-check": "7.0.2",
		"@yuu1111/tsconfig": "1.0.8",
		"knip": "^6.44.2",
		"typescript": "^7.0.2"
	}
}
