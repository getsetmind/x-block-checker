{
	"$schema": "./node_modules/@yuu1111/quality-check/schema.json",
	"failOnWarnings": true,
	"biome": true,
	"typecheck": true,
	"knip": true,
	"code": {
		"rules": {
			"preset": "all"
		}
	},
	"comment": {
		"rules": {
			"preset": "all"
		}
	},
	"markdown": {
		"rules": {
			"preset": "all"
		}
	},
	"tsdoc": {
		"rules": {
			"preset": "all",
			"single-line-doc": "error",
			"tsdoc-tag": "error",
			"missing-doc": "error"
		}
	}
}
