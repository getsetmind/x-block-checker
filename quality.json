{
	"$schema": "./node_modules/@yuu1111/quality-check/schema.json",
	"biome": true,
	"typecheck": true,
	"knip": true,
	"code": true,
	"comment": {
		"rules": {
			"cramped-comment": "on",
			"japanese-period": "on"
		}
	},
	"markdown": {
		"rules": {
			"japanese-period": "on"
		}
	},
	"tsdoc": {
		"rules": {
			"single-line-doc": "error",
			"tsdoc-tag": "error",
			"missing-doc": "error"
		}
	}
}
